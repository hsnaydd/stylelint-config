{
  "name": "@hsnaydd/stylelint-config",
  "version": "8.0.0",
  "description": "Shareable stylelint config for CSS and SCSS, with Prettier formatting and property ordering.",
  "main": "index.js",
  "files": [
    "index.js"
  ],
  "keywords": [
    "stylelint",
    "stylelint-config",
    "css",
    "scss",
    "prettier"
  ],
  "scripts": {
    "test": "node --test",
    "format": "prettier index.js test --write",
    "format:check": "prettier index.js test --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsnaydd/stylelint-config.git"
  },
  "author": "Hasan Aydoğdu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hsnaydd/stylelint-config/issues"
  },
  "homepage": "https://github.com/hsnaydd/stylelint-config#readme",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.5.33",
    "prettier": "^3.5.3",
    "stylelint": "^18.0.0"
  },
  "dependencies": {
    "postcss-scss": "^4.0.9",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "stylelint-prettier": "^5.1.0"
  },
  "devDependencies": {
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0"
  }
